<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.blogverse</groupId>
        <artifactId>blogverse-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>blogverse-unified</artifactId>
    <name>BlogVerse Unified Cloud Runner</name>
    <description>Unified single-JVM runner optimized for 512MB RAM free cloud hosting (Render)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.blogverse</groupId>
            <artifactId>auth-service</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.blogverse</groupId>
            <artifactId>user-service</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.blogverse</groupId>
            <artifactId>post-service</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.blogverse</groupId>
            <artifactId>interaction-service</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.blogverse</groupId>
            <artifactId>media-service</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.blogverse</groupId>
            <artifactId>notification-service</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.blogverse</groupId>
            <artifactId>search-service</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
