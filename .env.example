# ============================================================
# BlogVerse — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ─── Database ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ─── JWT ─────────────────────────────────────────────────────
# Minimum 64 characters, random string
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_replace_this
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# ─── Google OAuth2 ───────────────────────────────────────────
# Obtain from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Storage / File Uploads ──────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=blogverse-media

# ─── SMTP (Email — for password reset) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─── Service Ports ───────────────────────────────────────────
EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
POST_SERVICE_PORT=8083
INTERACTION_SERVICE_PORT=8084
MEDIA_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
SEARCH_SERVICE_PORT=8087

# ─── Eureka ──────────────────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ─── Frontend ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
